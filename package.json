{
  "name": "stock-motos-backend",
  "version": "1.0.0",
  "description": "Sistema de gestión Cris-Motos",
  "main": "main.js",
  "scripts": {
    "start": "node index.js",
    "electron": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.crismotos.app",
    "productName": "Cris-Motos",
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "src/**/*",
      "index.js",
      "main.js",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  }
}